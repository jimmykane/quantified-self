{
  "name": "quantified-self-io-functions",
  "version": "1.0.0",
  "main": "lib/functions/src/index.js",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@genkit-ai/google-genai": "^1.30.1",
    "@google-cloud/bigquery": "^8.1.1",
    "@google-cloud/billing": "^5.1.1",
    "@google-cloud/billing-budgets": "^6.1.1",
    "@google-cloud/tasks": "^6.2.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@sports-alliance/sports-lib": "21.0.3",
    "blob": "^0.1.0",
    "bs58": "^4.0.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "firebase-admin": "^13.6.1",
    "firebase-functions": "^7.0.5",
    "genkit": "^1.30.1",
    "google-auth-library": "^9.15.1",
    "node-fetch": "^2.7.0",
    "semver": "^7.7.4",
    "simple-oauth2": "^5.0.0",
    "stripe": "22.4.0",
    "xmldom": "^0.6.0",
    "zod": "^4.3.6"
  },
  "scripts": {
    "lint": "eslint . --fix",
    "build": "rm -rf lib && tsc",
    "serve": "npm run build && firebase serve --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "npm run build && firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "vitest run -c ./vitest.config.ts",
    "test:watch": "vitest -c ./vitest.config.ts",
    "test:coverage": "vitest run --coverage -c ./vitest.config.ts",
    "mcp:contract:check": "npm run build && npm run mcp:contract:check:compiled",
    "mcp:contract:check:compiled": "node lib/functions/src/scripts/mcp-contract.js check",
    "mcp:contract:capture": "npm run build && node lib/functions/src/scripts/mcp-contract.js capture",
    "mcp:contract:bootstrap": "npm run build && node lib/functions/src/scripts/mcp-contract.js bootstrap",
    "mcp:contract:promote": "npm run build && node lib/functions/src/scripts/mcp-contract.js promote",
    "secrets:check": "npm run build && npm run secrets:check:compiled",
    "secrets:check:compiled": "node lib/functions/src/scripts/check-secret-bindings.js",
    "secrets:audit-deployed": "npm run build && node lib/functions/src/scripts/audit-deployed-secret-env.js",
    "deploy:safety:compiled": "node lib/functions/src/scripts/check-deployment-files.js && npm run secrets:check:compiled",
    "seed-emails": "ts-node src/scripts/seed-email-templates.ts",
    "test-emails": "ts-node src/scripts/test-all-emails.ts",
    "queue-mcp-connection-update": "ts-node src/scripts/queue-mcp-connection-update.ts",
    "render-emails": "ts-node src/scripts/render-email-previews.ts",
    "cleanup-queue": "ts-node src/scripts/cleanup-queue.ts",
    "export-users": "ts-node src/scripts/export-users.ts",
    "cleanup-firestore": "ts-node -r ./src/scripts/load-local-env.ts src/scripts/cleanup-firestore.ts",
    "purge-retired-ai-insights-data": "ts-node -r ./src/scripts/load-local-env.ts src/scripts/purge-retired-ai-insights-data.ts",
    "cleanup-orphaned-users": "ts-node -r ./src/scripts/load-local-env.ts src/scripts/cleanup-orphaned-users.ts",
    "recover-suunto-outage": "ts-node -r ./src/scripts/load-local-env.ts src/scripts/recover-suunto-outage.ts",
    "correct-wahoo-workout-types": "ts-node -r ./src/scripts/load-local-env.ts src/scripts/correct-wahoo-workout-types.ts",
    "reparse-sports-lib-events": "ts-node -r ./src/scripts/load-local-env.ts src/scripts/reparse-sports-lib-events.ts",
    "migrate-storage-users-bucket": "ts-node -r ./src/scripts/load-local-env.ts src/scripts/migrate-storage-users-bucket.ts",
    "backfill-sports-lib-processing-code": "ts-node -r ./src/scripts/load-local-env.ts src/scripts/backfill-sports-lib-processing-code.ts",
    "migrate-health-sleep-sports-lib-data": "ts-node -r ./src/scripts/load-local-env.ts src/scripts/migrate-health-sleep-sports-lib-data.ts",
    "migrate-health-sleep-sports-lib-data-global": "ts-node -r ./src/scripts/load-local-env.ts src/scripts/migrate-health-sleep-sports-lib-data-global.ts",
    "backfill-coros-daily-health": "ts-node -r ./src/scripts/load-local-env.ts src/scripts/backfill-coros-daily-health.ts",
    "backfill-event-processing-entity": "ts-node -r ./src/scripts/load-local-env.ts src/scripts/backfill-event-processing-entity.ts",
    "backfill-route-processing-entity": "ts-node -r ./src/scripts/load-local-env.ts src/scripts/backfill-route-processing-entity.ts",
    "backfill-service-connection-projections": "ts-node -r ./src/scripts/load-local-env.ts src/scripts/backfill-service-connection-account-projections.ts",
    "audit-service-oauth-roots": "ts-node -r ./src/scripts/load-local-env.ts src/scripts/audit-service-oauth-roots.ts",
    "replace-stripe-price": "ts-node -r ./src/scripts/load-local-env.ts src/scripts/replace-stripe-price.ts"
  },
  "engines": {
    "node": "22"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  },
  "devDependencies": {
    "@types/bs58": "^4.0.1",
    "@types/cookie-parser": "^1.4.2",
    "@types/cors": "^2.8.8",
    "@types/node": "^25.0.9",
    "@types/node-fetch": "^2.6.9",
    "@types/semver": "^7.7.1",
    "@types/simple-oauth2": "^5.0.0",
    "@types/xmldom": "^0.1.31",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.1",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.29.1",
    "firebase-functions-test": "^3.4.1",
    "handlebars": "^4.7.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^3.2.4"
  }
}
