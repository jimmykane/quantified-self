# Copy this file to ~/.config/quantified-self/functions.env and add development-only values.
# npm run emulators:local creates the Firebase .secret.local override outside the checkout.
# Never reuse production credentials in an emulator checkout.
# Firebase Admin credentials do not belong here; emulated services require no Google credential.
COROSAPI_CLIENT_ID=
COROSAPI_CLIENT_SECRET=
GARMINAPI_CLIENT_ID=
GARMINAPI_CLIENT_SECRET=
GARMINAPI_WEBHOOK_SECRET=
GEMINI_API_KEY=
MAPBOX_ACCESS_TOKEN=
MARKETING_UNSUBSCRIBE_SIGNING_KEY=
STRIPE_BILLING_KEY=
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_ADMIN_BILLING_KEY=
STRIPE_SECRET_KEY=
SUUNTOAPP_CLIENT_ID=
SUUNTOAPP_CLIENT_SECRET=
SUUNTOAPP_GUIDE_OWNER=
SUUNTOAPP_NOTIFICATION_SECRET=
SUUNTOAPP_SUBSCRIPTION_KEY=
WAHOOAPI_ALLOWED_FILE_HOSTS=
WAHOOAPI_CLIENT_ID=
WAHOOAPI_CLIENT_SECRET=
WAHOOAPI_WEBHOOK_TOKEN=
