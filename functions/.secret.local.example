# These are deliberate non-secret sentinels. Firebase otherwise falls back to
# Google Secret Manager when an emulator secret is blank. Never replace them
# with development or production credentials in the isolated local runtime.
# Firebase Admin credentials do not belong here; emulated services require no
# service-account JSON or Google Application Default Credentials.
COROSAPI_CLIENT_ID=LOCAL_EMULATOR_DISABLED
COROSAPI_CLIENT_SECRET=LOCAL_EMULATOR_DISABLED
GARMINAPI_CLIENT_ID=LOCAL_EMULATOR_DISABLED
GARMINAPI_CLIENT_SECRET=LOCAL_EMULATOR_DISABLED
GEMINI_API_KEY=LOCAL_EMULATOR_DISABLED
MAPBOX_ACCESS_TOKEN=LOCAL_EMULATOR_DISABLED
STRIPE_ADMIN_BILLING_KEY=LOCAL_EMULATOR_DISABLED
STRIPE_SECRET_KEY=LOCAL_EMULATOR_DISABLED
SUUNTOAPP_CLIENT_ID=LOCAL_EMULATOR_DISABLED
SUUNTOAPP_CLIENT_SECRET=LOCAL_EMULATOR_DISABLED
SUUNTOAPP_NOTIFICATION_SECRET=LOCAL_EMULATOR_DISABLED
SUUNTOAPP_SUBSCRIPTION_KEY=LOCAL_EMULATOR_DISABLED
WAHOOAPI_ALLOWED_FILE_HOSTS=LOCAL_EMULATOR_DISABLED
WAHOOAPI_CLIENT_ID=LOCAL_EMULATOR_DISABLED
WAHOOAPI_CLIENT_SECRET=LOCAL_EMULATOR_DISABLED
WAHOOAPI_WEBHOOK_TOKEN=LOCAL_EMULATOR_DISABLED
