rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Existing client sessions can outlive the deletion request. Fence every
    // owner write until the server's retained deletion marker expires.
    function mayWriteAccount(userID) {
      let tombstonePath = /databases/$(database)/documents/userDeletionTombstones/$(userID);
      return request.auth != null && request.auth.uid == userID
        && (!exists(tombstonePath)
          || (get(tombstonePath).data.get('expireAt', null) is timestamp
            && get(tombstonePath).data.expireAt <= request.time));
    }

    // Make sure the uid of the requesting user matches name of the user
    // document. The wildcard expression {userId} makes the userId variable
    // available in rules.
    match /users/{userID} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userID;
      }

      function isValidEventTagName(tag) {
        return tag is string
          && tag.size() > 0
          && tag.size() <= 32
          && tag.matches('^\\S+( \\S+)*$');
      }

      function mayCreateEventTagCatalogEntry() {
        let userPath = /databases/$(database)/documents/users/$(userID);
        return exists(userPath)
          && mayWriteAccount(userID);
      }

      allow read: if isOwner();
      allow create: if mayWriteAccount(userID)
        && (
          !('creationDate' in request.resource.data)
          || request.resource.data.creationDate is timestamp
        );
      allow update: if mayWriteAccount(userID)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'creationDate'
        ]);
      allow delete: if false;
      
      // Private device registrations are leaves, never event/metric or MCP data.
      match /pushSubscriptions/{installationID} {
        function validId(value) { return value is string && value.matches('^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$'); }
        function validRegistration() {
          let d = request.resource.data;
          return d.keys().hasOnly(['schemaVersion', 'origin', 'vapidPublicKey', 'generation', 'endpoint', 'keys', 'updatedAt', 'device'])
            && d.keys().hasAll(['schemaVersion', 'origin', 'vapidPublicKey', 'generation', 'endpoint', 'keys', 'updatedAt'])
            && d.schemaVersion == 1 && validId(installationID) && validId(d.generation)
            && d.origin in ['https://quantified-self.io', 'https://beta.quantified-self.io']
            && d.vapidPublicKey is string && d.vapidPublicKey.matches('^B[A-Za-z0-9_-]{86}$')
            && d.endpoint is string && d.endpoint.size() <= 4096
            && d.endpoint.matches('^https://(fcm[.]googleapis[.]com|updates[.]push[.]services[.]mozilla[.]com|web[.]push[.]apple[.]com|[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?[.]notify[.]windows[.]com)/[A-Za-z0-9_./~%?=&+:-]+$')
            && d.keys is map && d.keys.keys().hasOnly(['p256dh', 'auth']) && d.keys.keys().hasAll(['p256dh', 'auth'])
            && d.keys.p256dh is string && d.keys.p256dh.matches('^B[A-Za-z0-9_-]{86}$')
            && d.keys.auth is string && d.keys.auth.matches('^[A-Za-z0-9_-]{22}$')
            && d.updatedAt == request.time
            && (!('device' in d) || (d.device is map && d.device.keys().hasOnly(['browser', 'platform'])
              && d.device.keys().hasAll(['browser', 'platform'])
              && d.device.browser in ['Chrome', 'Safari', 'Firefox', 'Edge', 'Opera', 'Samsung Internet', 'Browser']
              && d.device.platform in ['macOS', 'Windows', 'Android', 'iOS', 'ChromeOS', 'Linux', 'Unknown device']));
        }
        allow get: if isOwner();
        allow list: if isOwner() && !('impersonatedBy' in request.auth.token)
          && request.query.limit != null && request.query.limit <= 26;
        allow create, update: if mayWriteAccount(userID)
          && !('impersonatedBy' in request.auth.token)
          && exists(/databases/$(database)/documents/users/$(userID)) && validRegistration();
        allow delete: if isOwner() && !('impersonatedBy' in request.auth.token);
        match /{descendants=**} { allow read, write: if false; }
      }
      match /pushState/{document=**} { allow read, write: if false; }

      // Account-wide category preferences. Revisions cancel consent from before a toggle.
      // Leaves cannot be deleted/reset by clients, including when all categories are on.
      match /notificationPreferences/{category} {
        function validPreference() {
          let d = request.resource.data;
          return category in ['history_import', 'activity_sync', 'activity_delivery', 'training_sync']
            && d.keys().hasOnly(['schemaVersion', 'enabled', 'revision', 'updatedAt'])
            && d.keys().hasAll(['schemaVersion', 'enabled', 'revision', 'updatedAt'])
            && d.schemaVersion == 1 && d.enabled is bool
            && d.revision is int && d.revision >= 1 && d.revision <= 9007199254740991
            && d.updatedAt == request.time;
        }
        function mayWritePreference() {
          return mayWriteAccount(userID) && !('impersonatedBy' in request.auth.token)
            && exists(/databases/$(database)/documents/users/$(userID)) && validPreference();
        }
        allow get: if isOwner() && category in ['history_import', 'activity_sync', 'activity_delivery', 'training_sync'];
        allow list, delete: if false;
        allow create: if mayWritePreference() && request.resource.data.revision == 1;
        allow update: if mayWritePreference()
          && request.resource.data.enabled != resource.data.enabled
          && request.resource.data.revision == resource.data.revision + 1;
        match /{descendants=**} { allow read, write: if false; }
      }

      // Legal Agreements (Write-Once / Monotonic)
      match /legal/agreements {
        allow read: if request.auth.uid == userID;
        
        function isValidLegalAgreement() {
           return request.resource.data.keys().hasOnly([
             'acceptedPrivacyPolicy', 
             'acceptedDataPolicy', 
             'acceptedTrackingPolicy', 
             'acceptedMarketingPolicy',
             'acceptedDiagnosticsPolicy', 
             'acceptedTos'
           ]) &&
           (request.resource.data.get('acceptedPrivacyPolicy', true) == true) &&
           (request.resource.data.get('acceptedDataPolicy', true) == true) &&
           (request.resource.data.get('acceptedTrackingPolicy', false) is bool) &&
           (request.resource.data.get('acceptedMarketingPolicy', false) is bool) &&
           (request.resource.data.get('acceptedDiagnosticsPolicy', true) == true) &&
           (request.resource.data.get('acceptedTos', true) == true);
        }

        allow create: if mayWriteAccount(userID) && isValidLegalAgreement();
        
        allow update: if mayWriteAccount(userID)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'acceptedPrivacyPolicy', 
             'acceptedDataPolicy', 
             'acceptedTrackingPolicy', 
             'acceptedMarketingPolicy',
             'acceptedDiagnosticsPolicy', 
             'acceptedTos'
           ])
          && (request.resource.data.get('acceptedPrivacyPolicy', true) == true)
          && (request.resource.data.get('acceptedDataPolicy', true) == true)
          && (request.resource.data.get('acceptedTrackingPolicy', false) is bool)
          && (request.resource.data.get('acceptedMarketingPolicy', false) is bool)
          && (request.resource.data.get('acceptedDiagnosticsPolicy', true) == true)
          && (request.resource.data.get('acceptedTos', true) == true);
           
      }

      // Config Settings (Private / Owner Read-Write). Client-owned appSettings,
      // including Training destination and shortcut preferences, use this path.
      // Metric-affecting trainingSettings stay server-owned so benchmark changes
      // are validated and queue a targeted refresh through an App-Check callable.
      match /config/settings {
         allow read: if request.auth.uid == userID;
         allow create: if mayWriteAccount(userID)
           && !request.resource.data.keys().hasAny(['trainingSettings']);
         allow update: if mayWriteAccount(userID)
           && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['trainingSettings']);
         allow delete: if mayWriteAccount(userID)
           && !resource.data.keys().hasAny(['trainingSettings']);
      }

      // Compact derived load projections are private and exclusively server-owned.
      match /trainingLoadCache/{document} {
        allow read: if isOwner();
        allow write: if false;
      }

      // Immutable dated load preferences. The head and its new revision are committed together.
      match /trainingLoadPolicies/{family} {
        function validPolicy() {
          let data = request.resource.data;
          return family in ['running', 'cycling', 'swimming', 'rowing', 'walking-hiking', 'nordic-skiing',
            'strength', 'fitness-gym', 'paddling', 'wheelchair', 'climbing-mountaineering', 'mountain-snow',
            'skating', 'combat-martial-arts', 'dance', 'team-sports', 'racket-sports', 'precision-sports',
            'water-sports', 'diving', 'performance-sports', 'outdoor-adventures', 'aerial-sports',
            'motorized-activities', 'other-training']
            && data.keys().hasOnly(['revision', 'revisionId', 'method', 'included', 'effectiveAt', 'swimThresholdSpeed', 'functionalThresholdPower', 'lactateThresholdHR', 'runningThresholdSpeed', 'restingHeartRate', 'maxHeartRate', 'hrAlgorithm'])
            && data.revision is int && data.revision > 0
            && data.revisionId is string && data.revisionId.matches('^[a-zA-Z0-9-]{1,64}$')
            && data.method in ['AUTOMATIC', 'HR', 'MET', 'SWIM_PACE', 'RUNNING_PACE'] && data.included is bool
            && (data.method != 'SWIM_PACE' || family == 'swimming')
            && (data.method != 'RUNNING_PACE' || family == 'running')
            && (!('runningThresholdSpeed' in data) || (family == 'running'
              && data.runningThresholdSpeed is number && data.runningThresholdSpeed > 0
              && data.runningThresholdSpeed - data.runningThresholdSpeed == 0))
            && (!('swimThresholdSpeed' in data) || (family == 'swimming'
              && data.swimThresholdSpeed is number && data.swimThresholdSpeed > 0 && data.swimThresholdSpeed <= 100))
            && (!('functionalThresholdPower' in data) || (family in ['running', 'cycling']
              && data.functionalThresholdPower is number && data.functionalThresholdPower > 0
              && data.functionalThresholdPower - data.functionalThresholdPower == 0))
            && (!('lactateThresholdHR' in data) || (data.lactateThresholdHR is number
              && data.lactateThresholdHR > 0 && data.lactateThresholdHR - data.lactateThresholdHR == 0))
            && (!('restingHeartRate' in data) || (data.restingHeartRate is number
              && data.restingHeartRate > 0 && data.restingHeartRate - data.restingHeartRate == 0))
            && (!('maxHeartRate' in data) || (data.maxHeartRate is number
              && data.maxHeartRate > 0 && data.maxHeartRate - data.maxHeartRate == 0))
            && (!('hrAlgorithm' in data) || data.hrAlgorithm in ['BANISTER', 'THRESHOLD'])
            && (!(data.keys().hasAll(['restingHeartRate', 'lactateThresholdHR', 'maxHeartRate']))
              || (data.restingHeartRate < data.lactateThresholdHR && data.lactateThresholdHR < data.maxHeartRate))
            && data.effectiveAt == request.time;
        }
        function matchingRevision() {
          return getAfter(/databases/$(database)/documents/users/$(userID)/trainingLoadPolicies/$(family)/revisions/$(request.resource.data.revisionId)).data == request.resource.data;
        }
        allow read: if isOwner();
        allow create: if isOwner() && mayCreateEventTagCatalogEntry() && validPolicy()
          && request.resource.data.revision == 1 && matchingRevision();
        allow update: if isOwner() && mayCreateEventTagCatalogEntry() && validPolicy()
          && request.resource.data.revision == resource.data.revision + 1 && matchingRevision();
        allow delete: if false;
        match /revisions/{revisionId} {
          allow read: if isOwner();
          allow create: if isOwner() && mayCreateEventTagCatalogEntry()
            && request.resource.data.revisionId == revisionId
            && request.resource.data.effectiveAt == request.time
            && getAfter(/databases/$(database)/documents/users/$(userID)/trainingLoadPolicies/$(family)).data == request.resource.data;
          allow update, delete: if false;
        }
      }

      // Assistant usage is private and server-owned only.
      match /assistantUsage/{periodDocId} {
         allow read: if false;
         allow write: if false;
      }

      // Retired data stays client-inaccessible until the bounded Admin purge
      // deletes it after the Assistant usage-ledger reset.
      match /aiInsightsUsage/{periodDocId} {
         allow read: if false;
         allow write: if false;
      }

      // Assistant conversations contain private prompts and grounded replies.
      // They are available only through authenticated App Check callables.
      match /assistantConversations/{conversationID} {
         allow read, write: if false;
      }

      // Event merge operations contain server-owned idempotency and lease state.
      match /eventMergeOperations/{operationID} {
         allow read, write: if false;
      }

      // Admin-issued subscription gifts contain private audit reasons,
      // idempotency state, and per-user operation locks. Browser clients use
      // App-Check-protected admin callables and never access these directly.
      match /adminSubscriptionGifts/{operationID} {
         allow read, write: if false;
      }

      match /adminSubscriptionGiftState/{stateID} {
         allow read, write: if false;
      }

      // Short-lived provider-echo fingerprints are server-owned operational
      // receipts and never exposed to browser clients.
      match /activitySyncOutboundFingerprints/{fingerprintID} {
         allow read, write: if false;
      }

      // Delivery projections contain display fields only; authority stays server-owned.
      match /activitySends/{batchID} {
        allow read: if isOwner();
        allow write: if false;
        match /rows/{rowID} { allow read: if isOwner(); allow write: if false; }
      }
      match /activitySendOperations/{batchID}/{path=**} { allow read, write: if false; }
      match /activitySendQuota/{quotaID} { allow read, write: if false; }

      // Inactivity warnings and deletion authorization are exclusively server-owned.
      match /inactivityRetention/{document=**} { allow read, write: if false; }

      // System Status (Admin Only)
      match /system/status {
         allow read: if request.auth.uid == userID;
         allow write: if false; // Only Cloud Functions (Admin SDK)
      }

        match /eventTagCatalog/{tagKey} {
          allow get, list: if isOwner();
          allow create: if isOwner()
            && mayCreateEventTagCatalogEntry()
            && request.resource.data.keys().hasOnly(['name'])
            && request.resource.data.keys().hasAll(['name'])
            && isValidEventTagName(request.resource.data.name)
            && tagKey.matches('^[a-f0-9]{64}$');
          allow update, delete: if false;
        }

        match /events/{eventID} {
          function isPublicEvent() {
            return resource.data.privacy == 'public';
          }

          function serverOwnedEventFields() {
            return [
              'originalFile',
              'originalFiles',
              'isMerge',
              'mergeType',
              'toolSource',
              'sourceFilesCount',
              'activitiesCount',
              'comparisonTitle',
              'benchmarkStatus',
              'benchmarkSourceRevision',
              'benchmarkSourceWritePending',
              'privacy'
            ];
          }

          function isValidEventTag(tags, index) {
            return tags.size() <= index
              || isValidEventTagName(tags[index]);
          }

          function isValidEventTagList(tags) {
            return tags is list
              && tags.size() <= 10
              && tags.toSet().size() == tags.size()
              && isValidEventTag(tags, 0)
              && isValidEventTag(tags, 1)
              && isValidEventTag(tags, 2)
              && isValidEventTag(tags, 3)
              && isValidEventTag(tags, 4)
              && isValidEventTag(tags, 5)
              && isValidEventTag(tags, 6)
              && isValidEventTag(tags, 7)
              && isValidEventTag(tags, 8)
              && isValidEventTag(tags, 9);
          }

          function hasValidUpdatedEventTags() {
            let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
            return (!affectedKeys.hasAny(['tags'])
                || (request.resource.data.keys().hasAny(['tags'])
                  && isValidEventTagList(request.resource.data.tags))
                || (!request.resource.data.keys().hasAny(['tags'])
                  && (!request.resource.data.keys().hasAny(['benchmarkReviewTags'])
                    || isValidEventTagList(request.resource.data.benchmarkReviewTags))))
              && (!affectedKeys.hasAny(['benchmarkReviewTags'])
                || !request.resource.data.keys().hasAny(['benchmarkReviewTags'])
                || isValidEventTagList(request.resource.data.benchmarkReviewTags));
          }

          // RESTRICTED ACCESS: Must be owner AND have a valid role (Free, Basic, or PRO)
          // TEMPORARILY DISABLED FOR TESTING - Re-enable when ready to enforce paywall
          // allow read, write: if request.auth.uid == userID && isSubscribed();
          allow get: if isOwner() || isPublicEvent();
          allow list: if isOwner();
          allow create: if false;
          allow update: if mayWriteAccount(userID)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOwnedEventFields())
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'benchmarkResult', 'benchmarkResults', 'hasBenchmark', 'benchmarkDevices', 'benchmarkLatestAt'
              ]) || resource.data.get('benchmarkSourceWritePending', false) != true)
            && hasValidUpdatedEventTags();
          allow delete: if mayWriteAccount(userID);


            match /metaData/trainingLoad {
              function validControl(key, control, legs, legacy) {
                let ownedActivity = /databases/$(database)/documents/users/$(userID)/activities/$(key);
                let target = /databases/$(database)/documents/users/$(userID)/activities/$(control.get('activityId', '_'));
                return key is string && key.matches('^[a-zA-Z0-9_-]{1,128}$')
                  && (key in legs || (legacy && exists(ownedActivity) && get(ownedActivity).data.eventID == eventID))
                  && control is map && control.keys().hasOnly(['method', 'included', 'override', 'activityId', 'dismissed'])
                  && control.get('method', 'AUTOMATIC') in ['AUTOMATIC', 'HR', 'MET', 'SWIM_PACE', 'RUNNING_PACE']
                  && control.get('included', true) is bool
                  && (!('override' in control) || (control.override is number && control.override >= 0 && control.override <= 9999))
                  && (!('activityId' in control) || (key in legs && legs[key].activityId == null
                    && control.activityId is string && exists(target) && get(target).data.eventID == eventID))
                  && (!('dismissed' in control) || (key in legs && legs[key].activityId == null && control.dismissed == true
                    && control.keys().hasOnly(['dismissed'])));
              }
              function validLoadEdit(before) {
                let data = request.resource.data;
                let key = data.get('editedLegKey', null);
                let oldControls = before.get('controls', {});
                let legs = before.get('legs', {});
                return data.version == 1 && data.revision is int && data.revision == before.get('revision', 0) + 1
                  && (key == null || key is string)
                  && data.get('resetUnmatched', false) is bool
                  && (data.get('resetUnmatched', false) == before.get('resetUnmatched', false) || data.controls.size() == 0)
                  && data.updatedAt == request.time && data.excluded is bool && data.controls is map && data.controls.size() <= 100
                  && (data.controls.size() == 0
                    || (key is string && data.controls.diff(oldControls).affectedKeys().hasOnly([key])
                      && (!(key in data.controls) || validControl(key, data.controls[key], legs, !('legs' in before))))
                    || (key == null && data.controls == oldControls));
              }
              allow read: if isOwner();
              allow create: if isOwner() && mayCreateEventTagCatalogEntry()
                && exists(/databases/$(database)/documents/users/$(userID)/events/$(eventID))
                && request.resource.data.keys().hasOnly(['version', 'revision', 'excluded', 'controls', 'updatedAt', 'editedLegKey', 'resetUnmatched'])
                && validLoadEdit({});
              allow update: if isOwner() && mayCreateEventTagCatalogEntry()
                && exists(/databases/$(database)/documents/users/$(userID)/events/$(eventID))
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revision', 'excluded', 'controls', 'updatedAt', 'editedLegKey', 'resetUnmatched'])
                && validLoadEdit(resource.data);
              allow delete: if false;
            }

            // Private reflection leaves never inherit the public parent event read.
            match /workoutReflections/{reflectionID} {
              function activeRecording() {
                let event = get(/databases/$(database)/documents/users/$(userID)/events/$(eventID)).data;
                return mayCreateEventTagCatalogEntry()
                  && exists(/databases/$(database)/documents/users/$(userID)/events/$(eventID))
                  && event.get('mergeType', '') != 'benchmark'
                  && (event.get('isMerge', false) != true || event.get('mergeType', '') == 'multi')
                  && (reflectionID == 'recording'
                    || (reflectionID.matches('^activity_.+$')
                      && get(/databases/$(database)/documents/users/$(userID)/activities/$(reflectionID.replace('^activity_', ''))).data.eventID == eventID));
              }
              function validReflection() {
                let data = request.resource.data;
                return data.keys().hasOnly(['schemaVersion', 'revision', 'deleted', 'mutationId', 'note'])
                  && data.keys().hasAll(['schemaVersion', 'revision', 'deleted', 'mutationId', 'note'])
                  && data.schemaVersion == 1 && data.revision is int && data.revision > 0 && data.revision < 9007199254740991
                  && data.deleted is bool && data.mutationId is string
                  && data.mutationId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
                  && (data.note == null || (data.note is string && data.note.size() <= 2000
                    && data.note.trim().size() > 0
                    && !data.note.matches('[\\s\\S]*[\x00-\x08\x0b\x0c\x0e-\x1f\x7f][\\s\\S]*')))
                  && (data.deleted ? data.note == null : data.note != null);
              }
              allow get: if isOwner() && activeRecording();
              allow list: if false;
              allow create: if isOwner() && activeRecording() && validReflection() && request.resource.data.revision == 1;
              allow update: if isOwner() && activeRecording() && validReflection()
                && request.resource.data.revision == resource.data.revision + 1
                && request.resource.data.mutationId != resource.data.mutationId;
              // Clear content in a monotonic tombstone; stale clients cannot resurrect it.
              allow delete: if false;
            }

            // Restoring metaData inside events
            match /trainingCompletionEvidence/{document=**} {
              allow read, write: if false;
            }
            match /metaData/processing {
              allow read: if request.auth.uid == userID;
              // Processing metadata is server-owned (Cloud Functions/Admin SDK only).
              allow write: if false;
            }
            match /metaData/{document=**} {
              allow read: if request.auth.uid == userID;
            }

          }

        match /routes/{routeID} {
          function serverOwnedRouteFields() {
            return [
              'id',
              'userID',
              'originalFile',
              'originalFiles',
              'srcFileType',
              'sourceFileType',
              'creator',
              'createdAt',
              'importedAt',
              'updatedAt',
              'stats',
              'routes',
              'routeCount',
              'waypointCount',
              'pointCount',
              'activityTypes',
              'streamTypes',
              'bounds',
              'preview',
              'previewReady',
              'sourceSummary',
              'syncedDestinationServiceNames',
              'deliverySummaries'
            ];
          }

          function hasValidRouteName() {
            return request.resource.data.name is string
              && request.resource.data.name.size() > 0
              && request.resource.data.name.size() <= 120;
          }

          allow read: if request.auth.uid == userID;
          allow create: if false;
          allow update: if mayWriteAccount(userID)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOwnedRouteFields())
            && hasValidRouteName();
          allow delete: if mayWriteAccount(userID);

          match /metaData/processing {
            allow read: if request.auth.uid == userID;
            allow write: if false;
          }
          match /metaData/{document=**} {
            allow read: if request.auth.uid == userID;
          }
        }
          
          match /activities/{activityID} {
            // New Flat Activities Collection
            function isOwnEventRef(data) {
              return data.keys().hasAll(['eventID']) && (
                data.eventID is string &&
                exists(/databases/$(database)/documents/users/$(userID)/events/$(data.eventID))
              );
            }

            function parentEventIsPublic(data) {
              return data.keys().hasAll(['eventID']) && (
                data.eventID is string &&
                get(/databases/$(database)/documents/users/$(userID)/events/$(data.eventID)).data.privacy == 'public'
              );
            }

            allow read: if request.auth.uid == userID || parentEventIsPublic(resource.data);
            allow create: if false;
            allow delete: if false;
            allow update: if mayWriteAccount(userID)
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['eventID', 'userID', 'eventStartDate', 'sourceActivityKey', 'sourceIdentity', 'ascentCorrection', 'descentCorrection'])
              && isOwnEventRef(request.resource.data);
          }

        match /meta/{document=**} {
          allow read: if request.auth.uid == userID;
        }

        match /derivedMetrics/{document=**} {
          allow read: if request.auth.uid == userID;
          allow write: if false;
        }

        // Standalone calendar intent. It changes no workout, plan, provider consent or AI allowance.
        function validGoalDate(value) {
          let parts = value.split('-');
          let year = int(parts[0]);
          let month = int(parts[1]);
          let day = int(parts[2]);
          let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
          let days = month == 2 ? (leap ? 29 : 28) : (month in [4, 6, 9, 11] ? 30 : 31);
          return value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && year >= 100
            && month >= 1 && month <= 12 && day >= 1 && day <= days;
        }
        function goalStateBefore() {
          return exists(/databases/$(database)/documents/users/$(userID)/trainingGoalState/current)
            ? get(/databases/$(database)/documents/users/$(userID)/trainingGoalState/current).data
            : {'revision': 0, 'goalCount': 0};
        }
        match /trainingGoalState/{stateID} {
          allow read: if isOwner() && stateID == 'current';
          allow create, update: if isOwner() && stateID == 'current' && mayWriteAccount(userID)
            && exists(/databases/$(database)/documents/users/$(userID))
            && request.resource.data.keys().hasAll(['schemaVersion', 'revision', 'goalCount', 'lastGoalId'])
            && request.resource.data.keys().hasOnly(['schemaVersion', 'revision', 'goalCount', 'lastGoalId'])
            && request.resource.data.schemaVersion == 1 && request.resource.data.revision is int
            && request.resource.data.revision == goalStateBefore().revision + 1
            && request.resource.data.goalCount is int && request.resource.data.goalCount >= 1 && request.resource.data.goalCount <= 200
            && request.resource.data.lastGoalId is string
            && request.resource.data.goalCount == goalStateBefore().goalCount
              + (exists(/databases/$(database)/documents/users/$(userID)/trainingGoals/$(request.resource.data.lastGoalId)) ? 0 : 1)
            && getAfter(/databases/$(database)/documents/users/$(userID)/trainingGoals/$(request.resource.data.lastGoalId)).data.revision
              == (exists(/databases/$(database)/documents/users/$(userID)/trainingGoals/$(request.resource.data.lastGoalId))
                ? get(/databases/$(database)/documents/users/$(userID)/trainingGoals/$(request.resource.data.lastGoalId)).data.revision + 1 : 1);
          allow delete: if false;
        }
        match /trainingGoals/{goalID} {
          function validTarget(value) {
            return value == null || (value is map && value.keys().hasAll(['kind', 'value']) && value.keys().hasOnly(['kind', 'value'])
              && value.kind in ['workouts', 'days', 'duration', 'distance'] && value.value is number && value.value > 0
              && ((value.kind == 'workouts' && value.value is int && value.value <= 100)
                || (value.kind == 'days' && value.value is int && value.value <= 7)
                || (value.kind == 'duration' && value.value <= 604800)
                || (value.kind == 'distance' && value.value <= 10000000)));
          }
          function validGoal() {
            let v = request.resource.data;
            return v.keys().hasAll(['schemaVersion', 'id', 'name', 'kind', 'lifecycle', 'priority', 'startLocalDate',
                'targetLocalDate', 'sportScope', 'sport', 'objective', 'planId', 'weeklyTarget', 'revision', 'createdAtMs', 'updatedAtMs'])
              && v.keys().hasOnly(['schemaVersion', 'id', 'name', 'kind', 'lifecycle', 'priority', 'startLocalDate',
                'targetLocalDate', 'sportScope', 'sport', 'objective', 'planId', 'weeklyTarget', 'revision', 'createdAtMs', 'updatedAtMs'])
              && v.schemaVersion == 1 && v.id == goalID && goalID.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$')
              && v.name is string && v.name.size() > 0 && v.name.size() <= 120
              && v.kind in ['event', 'milestone', 'ongoing'] && v.lifecycle in ['active', 'paused', 'completed', 'archived']
              && v.priority in ['high', 'normal', 'low'] && validGoalDate(v.startLocalDate)
              && ((v.kind == 'ongoing' && v.targetLocalDate == null)
                || (v.kind != 'ongoing' && validGoalDate(v.targetLocalDate) && v.targetLocalDate >= v.startLocalDate))
              && v.sportScope in ['all', 'sport', 'family']
              && ((v.sportScope == 'all' && v.sport == null) || (v.sportScope != 'all' && v.sport is string && v.sport.size() > 0 && v.sport.size() <= 100))
              && v.objective is string && v.objective.size() <= 2000
              && (v.planId == null || (v.planId is string && v.planId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$')))
              && validTarget(v.weeklyTarget) && (v.kind == 'ongoing' || v.weeklyTarget == null)
              && v.revision is int && v.revision > 0 && v.revision <= 9007199254740991
              && v.createdAtMs is int && v.createdAtMs >= 0 && v.updatedAtMs is int && v.updatedAtMs >= v.createdAtMs
              && v.updatedAtMs <= request.time.toMillis() + 60000;
          }
          function stateChanged() {
            let state = getAfter(/databases/$(database)/documents/users/$(userID)/trainingGoalState/current).data;
            return state.revision == goalStateBefore().revision + 1 && state.lastGoalId == goalID;
          }
          allow get: if isOwner();
          allow list: if isOwner() && request.query.limit != null && request.query.limit <= 201;
          allow create: if isOwner() && mayWriteAccount(userID) && exists(/databases/$(database)/documents/users/$(userID))
            && validGoal() && stateChanged() && request.resource.data.revision == 1
            && (request.resource.data.planId == null || exists(/databases/$(database)/documents/users/$(userID)/trainingPlans/$(request.resource.data.planId)));
          allow update: if isOwner() && mayWriteAccount(userID) && exists(/databases/$(database)/documents/users/$(userID))
            && validGoal() && stateChanged() && request.resource.data.revision == resource.data.revision + 1
            && request.resource.data.createdAtMs == resource.data.createdAtMs && request.resource.data.updatedAtMs >= resource.data.updatedAtMs
            && (request.resource.data.planId == null || request.resource.data.planId == resource.data.planId
              || exists(/databases/$(database)/documents/users/$(userID)/trainingPlans/$(request.resource.data.planId)));
          allow delete: if false;
        }

        match /trainingRestDays/{localDate} {
          function validRestDay() {
            let value = request.resource.data;
            let parts = localDate.split('-');
            let year = int(parts[0]);
            let month = int(parts[1]);
            let day = int(parts[2]);
            let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
            let days = month == 2 ? (leap ? 29 : 28) : (month in [4, 6, 9, 11] ? 30 : 31);
            return localDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              && year >= 100 && month >= 1 && month <= 12 && day >= 1 && day <= days
              && value.keys().hasAll(['schemaVersion', 'localDate', 'isRestDay', 'revision'])
              && value.keys().hasOnly(['schemaVersion', 'localDate', 'isRestDay', 'revision'])
              && value.schemaVersion == 1 && value.localDate == localDate && value.isRestDay is bool
              && value.revision is int && value.revision > 0 && value.revision <= 9007199254740991;
          }
          allow get: if isOwner();
          allow list: if isOwner() && request.query.limit != null && request.query.limit <= 367;
          allow create: if isOwner() && exists(/databases/$(database)/documents/users/$(userID)) && mayWriteAccount(userID) && validRestDay()
            && request.resource.data.revision == 1;
          allow update: if isOwner() && exists(/databases/$(database)/documents/users/$(userID)) && mayWriteAccount(userID) && validRestDay()
            && request.resource.data.revision == resource.data.revision + 1;
          // A retained false marker preserves concurrency/retry fences. Account cleanup remains recursive.
          allow delete: if false;
        }

        // Current training-plan state is owner-readable for live UI listeners,
        // but every mutation is fenced and validated by App Check callables.
        // Nested revisions, receipts, and deletion locks remain server-only.
        match /trainingPlanState/{stateID} {
          allow read: if isOwner() && stateID == 'current';
          allow write: if false;

          // A staged full-prescription restore temporarily hides workout roots.
          // This leaf lets current clients pause and restart their listeners
          // without exposing the internal lock, request, or history payloads.
          match /availability/{availabilityID} {
            allow get: if isOwner() && stateID == 'current' && availabilityID == 'restore';
            allow list, write: if false;
          }

          match /{document=**} {
            allow read, write: if false;
          }
        }

        match /trainingPlans/{planID} {
          allow read: if isOwner();
          allow write: if false;

          match /{document=**} {
            allow read, write: if false;
          }
        }

        match /workoutLibrary/{itemID} {
          allow read: if isOwner();
          allow write: if false;

          match /{document=**} {
            allow read, write: if false;
          }
        }

        match /scheduledWorkouts/{workoutID} {
          allow read: if isOwner() && !exists(/databases/$(database)/documents/users/$(userID)/trainingPlanState/current/planDeletionLocks/_bulk_restore);
          allow write: if false;

          // Full strength prescription is owner-readable. Only the server may
          // derive and persist its V1 workout projection and companion together.
          match /strengthDetails/{detailsID} {
            allow read: if isOwner() && detailsID == 'current'
              && !exists(/databases/$(database)/documents/users/$(userID)/trainingPlanState/current/planDeletionLocks/_bulk_restore);
            allow write: if false;
          }

          match /{document=**} {
            allow read, write: if false;
          }
        }

        // Safe activity-link projections are owner-readable. Source identifiers,
        // account bindings, evidence and reverse uniqueness records stay private.
        match /trainingWorkoutCompletions/{workoutID} {
          allow read: if isOwner();
          allow write: if false;
        }
        match /trainingActivityCompletionLinks/{document=**} {
          allow read, write: if false;
        }

        // Owner-visible delivery projections only; consent and all writes require the focused callables.
        match /trainingDeliverySettings/{settingID} {
          allow read: if isOwner();
          allow write: if false;
        }
        match /trainingDeliveryStatuses/{deliveryID} {
          allow read: if isOwner();
          allow write: if false;
        }
        match /trainingDeliveryVerifications/{deliveryID} {
          allow read: if isOwner();
          allow write: if false;
        }
        match /trainingProviderCapacity/{document=**} { allow read, write: if false; }
        match /trainingDeliveryLedger/{document=**} { allow read, write: if false; }
        match /trainingDeliveryState/{document=**} { allow read, write: if false; }
        match /trainingDeliveryScopes/{document=**} { allow read, write: if false; }
        match /trainingMcpProposals/{document=**} { allow read, write: if false; }
        match /trainingMcpLibraryProposals/{document=**} { allow read, write: if false; }

        match /sleepSessions/{sleepSessionID} {
          allow read: if request.auth.uid == userID;
          allow write: if false;
        }

        match /sleepSyncState/{providerID} {
          allow read: if request.auth.uid == userID;
          allow write: if false;
        }

        // Terminal manual-mutation outcomes contain no measurement data. Only the
        // server may inspect or change them; recursive account cleanup removes them.
        match /manualHealthMeasurementDeletions/{document=**} {
          allow read, write: if false;
        }

        // Private calendar context. Permanent leaves; all mutations use guarded callables.
        match /timelineNotes/{noteID} {
          allow get: if isOwner();
          allow list: if isOwner() && request.query.limit != null && request.query.limit <= 65;
          allow write: if false;
        }
        match /timelineNoteDeletions/{document=**} {
          allow read, write: if false;
        }

        // Unified health source records are private owner-readable, server-written data.
        // List reads must carry the public page limit plus one look-ahead document.
        match /healthSourceRecords/{sourceRecordID} {
          allow get: if isOwner();
          allow list: if isOwner()
            && request.query.limit != null
            && request.query.limit <= 33;
          allow write: if false;
        }

        // Sample chunks are permanent leaf documents. Nested documents are not
        // matched, preserving the writer's document-only stale-chunk delete invariant.
        match /healthSampleChunks/{chunkID} {
          allow get: if isOwner();
          allow list: if isOwner()
            && request.query.limit != null
            && request.query.limit <= 9;
          allow write: if false;
        }

        match /healthSyncState/{providerID} {
          allow get: if isOwner();
          allow list: if isOwner()
            && request.query.limit != null
            && request.query.limit <= 6;
          allow write: if false;
        }

        // Durable cleanup tasks may contain private Storage object paths and
        // are owned exclusively by the rejected-route cleanup trigger.
        match /routeOriginalFileCleanup/{cleanupID} {
          allow read, write: if false;
        }

        // MCP connection summaries and all credential state are server-owned.
        // The app uses authenticated, App-Check-protected callables to list
        // and revoke connections without exposing token material.
        match /mcpConnections/{connectionID} {
          allow read, write: if false;
        }
    }

    match /mcpOAuthAuthorizationRequests/{document=**} {
      allow read, write: if false;
    }

    match /mcpOAuthAuthorizationCodes/{document=**} {
      allow read, write: if false;
    }

    match /mcpOAuthAccessTokens/{document=**} {
      allow read, write: if false;
    }

    match /mcpOAuthRefreshTokens/{document=**} {
      allow read, write: if false;
    }

    // Pre-upload route-original reservations must survive account-subtree
    // deletion until their exact Storage object has been reconciled.
    match /routeOriginalFileCleanup/{cleanupID} {
      allow read, write: if false;
    }

    // Backend-only leaves survive user-tree deletion until temporary uploads are reconciled.
    match /activitySendUploadCleanup/{document=**} {
      allow read, write: if false;
    }

    match /mcpOAuthRateLimits/{document=**} {
      allow read, write: if false;
    }

    function validBillingUrl(url) {
      // Loopback is accepted only by the native server's demo/emulator guard.
      return url is string && url.size() <= 2048
        && url.matches('^https://(beta[.])?quantified-self[.]io/.*|^http://(localhost|127[.]0[.]0[.]1):[0-9]+/.*');
    }
    match /configuration/inactiveAccounts { allow read, write: if false; }

    match /configuration/stripeBilling {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /stripeBillingPrices/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /stripeBillingAccounts/{document=**} { allow read, write: if false; }
    match /stripeBillingJobs/{document=**} { allow read, write: if false; }
    match /stripeBillingLocks/{document=**} { allow read, write: if false; }

    match /customers/{userID} {
      allow read: if request.auth.uid == userID;
      
      match /checkout_sessions/{id} {
        allow read: if request.auth.uid == userID;
        allow delete: if mayWriteAccount(userID);
        function validCheckout() {
          let data = request.resource.data;
          let control = get(/databases/$(database)/documents/configuration/stripeBilling).data;
          let price = get(/databases/$(database)/documents/stripeBillingPrices/$(data.price)).data;
          let tombstone = /databases/$(database)/documents/userDeletionTombstones/$(userID);
          return control.requestsEnabled == true
            && exists(/databases/$(database)/documents/users/$(userID))
            && (!exists(tombstone) || (get(tombstone).data.get('expireAt', null) is timestamp
              && get(tombstone).data.expireAt <= request.time))
            && data.keys().hasOnly(['price', 'mode', 'success_url', 'cancel_url',
              'allow_promotion_codes', 'automatic_tax', 'metadata', 'payment_method_collection', 'trial_period_days', 'checkout_terms_version'])
            && data.price is string && data.price.matches('^price_[a-zA-Z0-9]+$')
            && price.active == true && data.mode == price.mode
            && get(/databases/$(database)/documents/products/$(price.product)).data.active == true
            && data.allow_promotion_codes == true && data.automatic_tax == {'enabled': true}
            && data.metadata == {'firebaseUID': userID}
            && data.get('payment_method_collection', 'if_required') == 'if_required'
            && (!('checkout_terms_version' in data) || data.checkout_terms_version == 'pro-trial-payment-method-v1')
            && (!('trial_period_days' in data) || (data.mode == 'subscription'
              && data.trial_period_days is int && data.trial_period_days > 0
              && data.trial_period_days == price.trialDays))
            && validBillingUrl(data.success_url) && validBillingUrl(data.cancel_url);
        }
        // Immutable requests: price, trial and server results cannot be replaced.
        allow create: if request.auth != null && request.auth.uid == userID && validCheckout();
        allow update: if false;
      }
      match /subscriptions/{id} {
        allow read: if request.auth.uid == userID;
        match /invoices/{invoiceId} { allow read: if request.auth.uid == userID; }
      }
      match /payments/{id} {
        allow read: if request.auth.uid == userID;
      }
    }
    
    match /products/{id} {
      allow read: if true;
      match /prices/{id} {
        allow read: if true;
      }
      match /tax_rates/{id} {
        allow read: if true;
      }
    }


    // Provider OAuth state, credentials, stable identities, and lifecycle
    // fences are server-owned. The browser reads only the bounded connection
    // projection under users/{uid}/meta/{service}.
    match /suuntoAppAccessTokens/{userID}/{document=**} {
      allow read, write: if false;
    }

    match /COROSAPIAccessTokens/{userID}/{document=**} {
      allow read, write: if false;
    }

    match /garminAPITokens/{userID}/{document=**} {
      allow read, write: if false;
    }

    match /wahooAPIAccessTokens/{userID}/{document=**} {
      allow read, write: if false;
    }

    match /garminAPIActivityQueue/{userID} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /COROSAPIWorkoutQueue/{userID} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /suuntoAppWorkoutQueue/{userID} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /wahooAPIWorkoutQueue/{queueItemID} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /activitySyncQueue/{queueItemID} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /routeDeliverySyncQueue/{queueItemID} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /connectionHistoryImports/{document=**} { allow read, write: if false; }

    match /trainingDeliveryQueue/{document=**} { allow read, write: if false; }
    match /trainingDeliveryCorosIntegerClaims/{document=**} { allow read, write: if false; }
    match /trainingProviderCapacity/{document=**} { allow read, write: if false; }

    match /sleepSyncQueue/{queueItemID} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Short-lived signed Suunto Health webhook envelopes are backend-only.
    match /suuntoHealthWebhookIngress/{ingressID} {
      allow read, write: if false;
    }

    // One-way-keyed reverse index used only by signed Suunto Health ingress.
    match /suuntoHealthWebhookAccountBindings/{bindingID} {
      allow read, write: if false;
    }

    // Bounded provider-maintenance cursors are backend-only operational state.
    match /providerMaintenanceState/{document=**} {
      allow read, write: if false;
    }


    match /failed_jobs/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Marketing campaign content, recipient snapshots, cap and usage are backend-only.
    match /marketingCampaigns/{document=**} { allow read, write: if false; }
    match /marketingControl/{document=**} { allow read, write: if false; }
    match /marketingDispatchDays/{document=**} { allow read, write: if false; }

    // Daily admin dashboard snapshots are exposed only through the
    // authenticated, App Check-protected admin callable.
    match /adminDashboardSnapshots/{snapshotDate} {
      allow read, write: if false;
    }
    
    match /changelogs/{docId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }
  }
}

service firebase.storage {
  match /b/{bucket}/o {
    match /assets/{allPaths=**} {
       allow read;
    }
  }
}
